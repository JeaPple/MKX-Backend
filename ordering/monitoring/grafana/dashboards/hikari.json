      "targets": [
        {
          "expr": "hikaricp_connections_active{job=\"ordering\"}",
          "legendFormat": "{{instance}} / {{pool}} active",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle{job=\"ordering\"}",
          "legendFormat": "{{instance}} / {{pool}} idle",
          "refId": "B"
