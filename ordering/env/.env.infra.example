# Private IP or private DNS name of the infrastructure instance, reachable from WAS.
# Example: 10.0.2.15 or ip-10-0-2-15.ap-northeast-2.compute.internal
KAFKA_ADVERTISED_HOST=10.0.2.15

# Address on the infrastructure instance where Docker publishes Redis and Kafka.
# 0.0.0.0 is suitable when the instance firewall/security group restricts access.
INFRA_BIND_ADDRESS=0.0.0.0